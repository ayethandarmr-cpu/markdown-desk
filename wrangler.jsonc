{
  // Cloudflare Worker that serves md.cwslab.win from the Vite build output.
  // Workers Builds runs `npm run build` and then `npx wrangler deploy` on every push to main.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markdown-desk",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
